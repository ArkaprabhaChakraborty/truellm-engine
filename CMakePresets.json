{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TRUELLM_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug (CPU)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TRUELLM_BACKEND": "CPU",
        "TRUELLM_SANITIZERS": "address;undefined"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-release",
      "displayName": "Linux Release (CPU)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TRUELLM_BACKEND": "CPU"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-cuda",
      "displayName": "Linux Release (CUDA)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TRUELLM_BACKEND": "CUDA",
        "CMAKE_CUDA_ARCHITECTURES": "75;80;86;89;90;120",
        "TRUELLM_BUILD_CUDA_ENGINE": "ON",
        "GGML_CUDA_NO_VMM": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "windows-debug",
      "displayName": "Windows Debug (CPU)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TRUELLM_BACKEND": "CPU"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-cuda",
      "displayName": "Windows Release (CUDA)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TRUELLM_BACKEND": "CUDA",
        "CMAKE_CUDA_ARCHITECTURES": "75;80;86;89;90;120",
        "TRUELLM_BUILD_CUDA_ENGINE": "ON",
        "GGML_CUDA_NO_VMM": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],

  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-cuda",    "configurePreset": "linux-cuda" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-cuda",  "configurePreset": "windows-cuda" }
  ],

  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
